      "desc": "A character is one start bit, eight data bits least-significant bit first, an\noptional parity bit and one stop bit.  The receiver qualifies the start bit at\nthe half-bit point, so a glitch shorter than half a bit period must not begin\nreception.",
      "goals": [
        {
          "custom": {
            "covsight": {
              "approach": "Boundary UVCs, directed sequences, constrained-random stimulus, assertions, and a reference model targeting Character framing.",
              "coverage_score": 8,
              "difficulty": 3,
              "env": "ip_simulation",
              "exit_criteria": [
                "100% regression pass for all planned tests",
                "95%+ functional coverage for implemented scope",
                "100% assertion pass"
              ],
              "overall_score": 64,
              "reasoning": "Provides controllability and observability for timing and data bug classes at practical regression run time.",
              "scope": "block"
            }
          },
          "id": "FEAT-001.ip_simulation",
          "testpoints": [
            {
              "coverage": [
                {
                  "path": "uart_env.uart_cfg_cg",
                  "type": "covergroup"
                },
                {
                  "path": "uart_env.uart_cfg_cg.parity_cp",
                  "type": "coverpoint"
                }
              ],
              "custom": {
                "covsight": {
                  "env": "ip_simulation",
                  "feature": "FEAT-001",
                  "title": "Start bit qualification"
                }
              },
              "desc": "Drive a falling edge on RX and confirm a character begins; drive a glitch\nshorter than half a bit period and confirm none does.  Both polarities of the\nline at the sampling instant are checked.",
              "name": "FEAT-001.tp_start_bit",
              "priority": "high",
              "requirements": [
                {
                  "item_id": "UART_1_1_1",
                  "system": "spec",
                  "url": "https://dvkit.org/covsight/sphinx-covsight/example/spec/uart.html#UART_1_1_1"
                }
              ],
              "stage": "V1",
              "tags": [
                "smoke"
              ],
              "tests": [
                "uart_framing_test",
                "uart_smoke_test"
              ]
            },
            {
              "coverage": [
                {
                  "path": "uart_env.uart_cfg_cg.parity_cp",
                  "type": "coverpoint"
                },
                {
                  "path": "uart_env.uart_cfg_cg.cfg_x",
                  "type": "cross"
                }
              ],
              "custom": {
                "covsight": {
                  "env": "ip_simulation",
                  "feature": "FEAT-001",
                  "title": "Parity generation and checking"
                }
              },
              "desc": "Sweep both parity polarities against random payloads and confirm the generated\nparity bit and the receiver's error reporting agree with the specification.\nThe parity mode is programmed through the {rdl:doc-ref}`uart.CTRL` register.",
              "name": "FEAT-001.tp_parity",
              "priority": "medium",
              "requirements": [
                {
                  "item_id": "uart.CTRL.PARITY_EN",
